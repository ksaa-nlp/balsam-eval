# Onboarding synthesis LLM (only the synthesize stage uses it).
# One key; the provider is taken from DECISION_SPEC_LLM_PROVIDER, else from the key
# (sk-ant-... is Anthropic, anything else is OpenAI-compatible).
DECISION_SPEC_LLM_API_KEY=
# anthropic | openai
DECISION_SPEC_LLM_PROVIDER=
# Defaults: claude-opus-5-5 (anthropic), gpt-5.1 (openai)
DECISION_SPEC_LLM_MODEL=
# Optional: an OpenAI-compatible host (e.g. https://api.groq.com/openai/v1) or a proxy
DECISION_SPEC_LLM_BASE_URL=
